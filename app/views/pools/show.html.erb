<div id="c-pools">
  <div id="a-show">
    <h2>
      <%= @pool.pretty_category %>:
      <%= link_to @pool.pretty_name, posts_path(tags: "pool:#{@pool.id}"), class: "pool-category-#{@pool.category}" %>
    </h2>

    <div id="description" class="dtext-container">
      <%= format_text(@pool.description) %>
    </div>

    <% if @all_reader_posts.any? %>
      <script type="application/json" id="pool-reader-data"><%= json_escape(@all_reader_posts.map { |p| pool_reader_post_data(p) }.to_json).html_safe %></script>

      <div id="pool-reader" role="region" aria-label="Pool reader">
        <div class="pool-reader-header">
          <span id="pool-reader-counter"></span>
        </div>
        <div class="pool-reader-main">
          <div class="pool-reader-media-container" id="pool-reader-media-container"></div>

          <button class="pool-reader-nav pool-reader-prev" id="pool-reader-prev" type="button" aria-label="Previous page">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="pool-reader-nav pool-reader-next" id="pool-reader-next" type="button" aria-label="Next page">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>

          <div class="pool-reader-controls-overlay">
            <button class="pool-reader-ctrl-btn" id="pool-reader-toggle-filmstrip" type="button" title="Toggle thumbnails">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="4" width="20" height="4" rx="1"/><rect x="2" y="10" width="20" height="4" rx="1"/><rect x="2" y="16" width="20" height="4" rx="1"/></svg>
            </button>
            <a class="pool-reader-ctrl-btn" id="pool-reader-view-post" href="#" title="View post" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
            <button class="pool-reader-ctrl-btn" id="pool-reader-fullscreen" type="button" title="Fullscreen">
              <svg class="pool-reader-fs-enter" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              <svg class="pool-reader-fs-exit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="3" y2="21"/><line x1="21" y1="3" x2="14" y2="10"/></svg>
            </button>
          </div>
        </div>
        <div class="pool-reader-filmstrip" id="pool-reader-filmstrip"></div>
      </div>
    <% end %>

    <%= render "posts/partials/common/inline_blacklist" %>

    <div id="posts">
      <section class="posts-container">
        <% if @posts.none? %>
          <%= render "posts/blank" %>
        <% else %>
          <%= render(PostThumbnailComponent.with_collection(@posts, pool_id: @pool.id, show_deleted: true)) %>
        <% end %>
      </div>
    </div>
    <%= render PaginatorComponent.new(records: @posts) %>
  </div>
</div>

<%= render "secondary_links" %>

<% render(partial: "static/embed", locals: { record: @pool, name: @pool.pretty_name, description: format_plaintext(@pool.description), post: @pool.cover_post }) %>

<% content_for(:page_title) do %>
  Pool - <%= @pool.pretty_name %>
<% end %>
